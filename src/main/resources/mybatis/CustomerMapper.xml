        <!--                and	DATE_FORMAT(f.create_time,'%Y-%m-%d') &lt;=	#{endTime}-->
        <!--            </if>-->
        <!--        </if>-->
        <if test='pageType != null and pageType == "1"'>
            order by t.${orderField} ${orderRule} limit #{start},#{pageSize}
        </if>
    </select>
    <update id="editList" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            update lx_customer f
            <set>
                f.class_id = #{item.classId},
            </set>
            where f.id = #{item.id}
        </foreach>
    </update>
</mapper>