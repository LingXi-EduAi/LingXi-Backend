        <!--                and	DATE_FORMAT(f.create_time,'%Y-%m-%d') &lt;=	#{endTime}-->
        <!--            </if>-->
        <!--        </if>-->
    </select>
    <select id="list" parameterType="com.lxe.lx.domain.qo.CustomerQO" resultType="com.lxe.lx.pojo.Customer">
        select t.id,
        t.user_id,
        t.name,
        t.password,
        t.class_id,
        t.grade,
        t.age,
        t.phone_number,
        t.email,
        t.create_time,
        t.state,
        t.version,
        t.update_id,
        t.update_time
        from lx_customer as t
        where 1 = 1
