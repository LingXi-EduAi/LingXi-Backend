    <select id="getGradeById" resultMap="Grade" parameterType="java.lang.String">
        select t.id,
               t.grade,
               t.class_id,
               t.student_id,
               t.subject,
               t.create_id,
               t.create_time,
               t.update_id,
               t.update_time,
               t.state,
               t.version from lx_grade as t
        where t.id = #{id}
    </select>
    <select id="num" parameterType="com.lxe.lx.domain.qo.GradeQO" resultType="java.lang.Integer">
        select count(*) from lx_grade f
        where 1 = 1
