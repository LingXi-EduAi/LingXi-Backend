        <!--            </if>-->
        <!--            <if test="endTime != null and endTime != ''">&lt;!&ndash; 单据日期检索 &ndash;&gt;-->
        <!--                and	DATE_FORMAT(f.create_time,'%Y-%m-%d') &lt;=	#{endTime}-->
        <!--            </if>-->
        <!--        </if>-->
        <if test='pageType != null and pageType == "1"'>
            order by f.${orderField} ${orderRule} limit #{start},#{pageSize}
        </if>
    </select>
    <delete id="deleteById" parameterType="java.lang.String">
        delete from lx_conversation where id = #{id}
    </delete>
</mapper>