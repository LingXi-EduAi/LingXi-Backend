<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxe.lx.mapper.ConversationMapper">
    <resultMap id="Conversation" type="com.lxe.lx.pojo.Conversation">
        <id column="id" jdbcType="VARCHAR" property="id" />
        <result column="teacher_id" jdbcType="VARCHAR" property="teacherId" />
        <result column="student_id" jdbcType="VARCHAR" property="studentId" />
        <result column="conversation_id" jdbcType="VARCHAR" property="conversationId" />
        <result column="create_id" jdbcType="VARCHAR" property="createId" />
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_id" jdbcType="VARCHAR" property="updateId" />
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
        <result column="state" jdbcType="VARCHAR" property="state" />
        <result column="version" jdbcType="INTEGER" property="version" />
    </resultMap>
    <sql id="tableName">
        lx_conversation
    </sql>
    <insert id="add" parameterType="com.lxe.lx.pojo.Conversation">
        insert into lx_conversation
        (id,
         teacher_id,
         student_id,
         conversation_id,
         create_id,
         create_time,
         state,
         version
        )values(
                   #{id},
                   #{teacherId},
                   #{studentId},
                   #{conversationId},
                   #{createId},
                   #{createTime},
                   #{state},
                   #{version}
               )
    </insert>
    <update id="edit" parameterType="com.lxe.lx.pojo.Conversation">
        update
        lx_conversation
        set
        <if test="teacherId !=null and teacherId !=''">
            teacher_id = #{teacherId},
        </if>
        <if test="studentId !=null and studentId !=''">
            student_id = #{studentId},
        </if>
        <if test="conversationId !=null and conversationId !=''">
            conversation_id = #{conversationId},
        </if>
        <if test="updateId !=null and updateId !=''">
            update_id = #{updateId},
        </if>
        <if test="updateTime !=null and updateTime !=''">
            update_time = #{updateTime},
        </if>
        <!--        <if test="version !=null and version !=''">-->
        <!--            version = #{version},-->
        <!--        </if>-->
        <if test="state !=null and state !=''">
            state = #{state},
        </if>
        version = version+1
        where
        id = #{id}
    </update>
    <select id="getConversationById" resultMap="Conversation" parameterType="java.lang.String">
        select f.id,
               f.teacher_id,
               f.student_id,
               f.conversation_id,
               f.create_id,
               f.create_time,
               f.update_id,
               f.update_time,
               f.state,
               f.version from lx_conversation as f
        where f.id= #{id}
    </select>
    <select id="num" parameterType="com.lxe.lx.domain.qo.ConversationQO" resultType="java.lang.Integer">
        select count(*) from lx_conversation f
        where 1 = 1
        <!--        <if test='queryType != null and queryType == "0"'>-->
        <!--            <if test="condition != null and condition != ''">&lt;!&ndash; 关键词检索 &ndash;&gt;-->
        <!--                and-->
        <!--                (-->
        <!--                f.entrustment_no like concat('%',#{condition} ,'%' )-->
        <!--                )-->
        <!--            </if>-->
        <!--        </if>-->
        <!--         <if test='queryType != null and queryType == "1"'>-->
        <if test="teacherId != null and teacherId != ''">
            and	f.teacher_id = #{teacherId}
        </if>
        <if test="studentId != null and studentId != ''">
            and	f.student_id = #{studentId}
        </if>
        <if test="conversationId != null and conversationId != ''">
            and	f.conversation_id = #{conversationId}
        </if>
        <if test="state != null and state != ''">
            and	f.state = #{state}
        </if>
        <!--            <if test="status != null ">-->
        <!--                and	f.status = #{status}-->
        <!--            </if>-->
        <!--            <if test="startTime != null and startTime != ''">&lt;!&ndash; 单据日期检索 &ndash;&gt;-->
        <!--                and	DATE_FORMAT(f.create_time,'%Y-%m-%d')>=	#{startTime}-->
        <!--            </if>-->
        <!--            <if test="endTime != null and endTime != ''">&lt;!&ndash; 单据日期检索 &ndash;&gt;-->
        <!--                and	DATE_FORMAT(f.create_time,'%Y-%m-%d') &lt;=	#{endTime}-->
        <!--            </if>-->
        <!--        </if>-->
    </select>
    <select id="list" parameterType="com.lxe.lx.domain.qo.ConversationQO" resultType="com.lxe.lx.pojo.Conversation">
        select f.id,
        f.teacher_id as teacherId,
        f.student_id as studentId,
        f.conversation_id as conversationId,
        f.create_id as createId,
        f.create_time as createTime,
        f.update_id as updateId,
        f.update_time as updateTime,
        f.state,
        f.version
        from lx_conversation f
        where 1 = 1
        <!--        <if test='queryType != null and queryType == "0"'>-->
        <!--            <if test="condition != null and condition != ''">&lt;!&ndash; 关键词检索 &ndash;&gt;-->
        <!--                and-->
        <!--                (-->
        <!--                f.entrustment_no like concat('%',#{condition} ,'%' )-->
        <!--                )-->
        <!--            </if>-->
        <!--        </if>-->
        <!--         <if test='queryType != null and queryType == "1"'>-->
        <if test="teacherId != null and teacherId != ''">
            and	f.teacher_id = #{teacherId}
        </if>
        <if test="studentId != null and studentId != ''">
            and	f.student_id = #{studentId}
        </if>
        <if test="conversationId != null and conversationId != ''">
            and	f.conversation_id = #{conversationId}
        </if>
        <if test="state != null and state != ''">
            and	f.state = #{state}
        </if>
        <!--            <if test="status != null ">-->
        <!--                and	f.status = #{status}-->
        <!--            </if>-->
        <!--            <if test="startTime != null and startTime != ''">&lt;!&ndash; 单据日期检索 &ndash;&gt;-->
