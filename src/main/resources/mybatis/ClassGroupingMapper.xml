    <select id="getClassGroupingById" resultMap="ClassGrouping" parameterType="java.lang.String">
        select f.id,
               f.name,
               f.class_rule,
               f.class_condition,
               f.volume,
               f.create_id,
               f.create_time,
               f.update_id,
               f.update_time,
               f.state,
               f.version from lx_class_grouping as f
        where f.id= #{id}
