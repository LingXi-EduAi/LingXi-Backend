    <insert id="add" parameterType="com.lxe.lx.pojo.ClassGrouping">
        insert into lx_classGrouping
        (id,
         name,
         rule,
         condition,
         volume,
         create_id,
         create_time,
         state,
         version
        )values(
                   #{id},
                   #{name},
                   #{rule},
                   #{condition},
                   #{volume},
                   #{createId},
                   #{createTime},
                   #{state},
                   #{version}
               )
    </insert>
    <update id="edit" parameterType="com.lxe.lx.pojo.ClassGrouping">
        update
        lx_classGrouping
        set
        <if test="name !=null and name !=''">
            name = #{name},
        </if>
        <if test="rule !=null and rule !=''">
            rule = #{rule},
        </if>
        <if test="condition !=null and condition !=''">
            condition = #{condition},
        </if>
        <if test="volume !=null and volume !=''">
            volume = #{volume},
        </if>
        <if test="updateId !=null and updateId !=''">
            update_id = #{updateId},
        </if>
        <if test="updateTime !=null and updateTime !=''">
            update_time = #{updateTime},
        </if>
        <!--        <if test="version !=null and version !=''">-->
        <!--            version = #{version},-->
        <!--        </if>-->
        <if test="state !=null and state !=''">
            state = #{state},
        </if>
        version = version+1
        where
        id = #{id}
    </update>
