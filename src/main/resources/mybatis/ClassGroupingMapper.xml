<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxe.lx.mapper.ClassGroupingMapper">
    <resultMap id="ClassGrouping" type="com.lxe.lx.pojo.ClassGrouping">
        <id column="id" jdbcType="VARCHAR" property="id" />
        <result column="name" jdbcType="VARCHAR" property="name" />
        <result column="class_rule" jdbcType="VARCHAR" property="classRule" />
        <result column="class_condition" jdbcType="VARCHAR" property="classCondition" />
        <result column="volume" jdbcType="INTEGER" property="volume" />
        <result column="create_id" jdbcType="VARCHAR" property="createId" />
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
        <result column="update_id" jdbcType="VARCHAR" property="updateId" />
        <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
        <result column="state" jdbcType="VARCHAR" property="state" />
        <result column="version" jdbcType="INTEGER" property="version" />
    </resultMap>
    <sql id="tableName">
        lx_class_grouping
    </sql>
    <insert id="add" parameterType="com.lxe.lx.pojo.ClassGrouping">
        insert into lx_class_grouping
        (id,
         name,
         class_rule,
         class_condition,
         volume,
         create_id,
         create_time,
         state,
         version
        )values(
                   #{id},
                   #{name},
                   #{classRule},
                   #{classCondition},
                   #{volume},
                   #{createId},
                   #{createTime},
                   #{state},
                   #{version}
               )
    </insert>
    <update id="edit" parameterType="com.lxe.lx.pojo.ClassGrouping">
        update
        lx_class_grouping
        set
        <if test="name !=null and name !=''">
            name = #{name},
        </if>
        <if test="classRule !=null and classRule !=''">
            class_rule = #{classRule},
        </if>
        <if test="classCondition !=null and classCondition !=''">
            class_condition = #{classCondition},
        </if>
        <if test="volume !=null and volume !=''">
            volume = #{volume},
        </if>
        <if test="updateId !=null and updateId !=''">
            update_id = #{updateId},
        </if>
        <if test="updateTime !=null and updateTime !=''">
            update_time = #{updateTime},
        </if>
        <!--        <if test="version !=null and version !=''">-->
        <!--            version = #{version},-->
        <!--        </if>-->
        <if test="state !=null and state !=''">
            state = #{state},
        </if>
        version = version+1
        where
        id = #{id}
    </update>
    <select id="num" parameterType="com.lxe.lx.domain.qo.ClassGroupingQO" resultType="java.lang.Integer">
