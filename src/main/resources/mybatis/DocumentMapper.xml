        <!--            </if>-->
        <!--        </if>-->
        <!--         <if test='queryType != null and queryType == "1"'>-->
        <if test="name != null and name != ''">
            and	f.name = #{name}
        </if>
        <if test="type != null and type != ''">
            and	f.type = #{type}
        </if>
        <if test="state != null and state != ''">
            and	f.state = #{state}
        </if>
