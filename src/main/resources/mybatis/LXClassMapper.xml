        <!--                )-->
        <!--            </if>-->
        <!--        </if>-->
        <!--         <if test='queryType != null and queryType == "1"'>-->
        <if test="name != null and name != ''">
            and	f.name = #{name}
        </if>
        <if test="classGroupingId != null and classGroupingId != ''">
            and	f.class_grouping_id = #{classGroupingId}
        </if>
        <if test="teacherId != null and teacherId != ''">
            and	f.teacher_id = #{teacherId}
