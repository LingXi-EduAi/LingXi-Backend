<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lxe.lx.mapper.AiMessageMapper">
    <resultMap id="AiMessageMap" type="com.lxe.lx.pojo.AiMessage">
        <id column="id" property="id"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="task_id" property="taskId"/>
        <result column="role" property="role"/>
        <result column="content" property="content"/>
        <result column="status" property="status"/>
        <result column="dify_message_id" property="difyMessageId"/>
        <result column="attachments" property="attachments"/>
        <result column="error_code" property="errorCode"/>
        <result column="error_message" property="errorMessage"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.lxe.lx.pojo.AiMessage">
        INSERT INTO ai_message
        (id, conversation_id, task_id, role, content, status, dify_message_id,
         attachments, error_code, error_message, created_at)
        VALUES
        (#{id}, #{conversationId}, #{taskId}, #{role}, #{content}, #{status}, #{difyMessageId},
         #{attachments}, #{errorCode}, #{errorMessage}, #{createdAt})
        ON DUPLICATE KEY UPDATE id = id
    </insert>

    <select id="findByDifyMessageId" resultMap="AiMessageMap">
        SELECT * FROM ai_message WHERE dify_message_id = #{difyMessageId}
    </select>

    <select id="findByTaskAndRole" resultMap="AiMessageMap">
        SELECT * FROM ai_message
        WHERE task_id = #{taskId} AND role = #{role}
        ORDER BY created_at DESC, id DESC
        LIMIT 1
    </select>

    <select id="findByConversation" resultMap="AiMessageMap">
        SELECT * FROM ai_message
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at DESC, id DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="countByConversation" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ai_message WHERE conversation_id = #{conversationId}
    </select>

    <delete id="deleteOlderThan">
        DELETE FROM ai_message WHERE created_at &lt; #{cutoff}
    </delete>

    <delete id="deleteByConversation">
        DELETE FROM ai_message WHERE conversation_id = #{conversationId}
    </delete>
</mapper>
